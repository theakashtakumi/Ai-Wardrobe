# Copy values into the backend process environment for local development.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional custom paths (defaults are backend/data/wardrobe.sqlite3 and backend/uploads)
# DATABASE_PATH=C:/data/wardrobe.sqlite3
# WARDROBE_UPLOAD_DIR=C:/data/wardrobe-uploads
# Optional local Ollama vision model; leave unset for manual entry only.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llava
# In frontend/.env.local, set VITE_API_BASE_URL=http://127.0.0.1:8000 if API is elsewhere.
# VITE_API_URL remains supported as a compatibility alias.
